# Pilot-deploy (Render): NODE_ENV=production zorgt er standaard voor dat npm de
# devDependencies OVERSLAAT. Maar de build (Vite + PostCSS/Tailwind) heeft
# tailwindcss/postcss/autoprefixer nodig, die in devDependencies staan.
# Deze regel forceert een volledige install (incl. devDependencies) zodat de
# build-tools beschikbaar zijn. Runtime-gedrag ongewijzigd.
production=false
legacy-peer-deps=true
